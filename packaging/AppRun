#!/bin/sh
# Lanceur de l'AppImage IA Locale (interface native Qt, aucun navigateur, aucun serveur local).
HERE="$(dirname "$(readlink -f "$0")")"
export IA_LOCALE_APP_DIR="${IA_LOCALE_APP_DIR:-$HERE}"
export PYTHONPATH="$HERE/usr/lib/ia-locale:$HERE/usr/lib/ia-locale-deps${PYTHONPATH:+:$PYTHONPATH}"
export QT_PLUGIN_PATH="$HERE/usr/lib/ia-locale-deps/PySide6/Qt/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$HERE/usr/lib/ia-locale-deps/PySide6/Qt/plugins/platforms"
export LD_LIBRARY_PATH="$HERE/usr/lib/ia-locale-libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/python/bin/python3" -m ia_locale.main "$@"
